    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.17",
    "vite": "^7.2.2"
  },
  "devDependencies": {
    "prettier": "^3.10.1"
  }
}
