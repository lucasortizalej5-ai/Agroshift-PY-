# Copiar a .env en la raíz. No subir .env a Git.
APP_ENV=development
DATABASE_PATH=backend/data/agroshift.sqlite3
API_BASE_URL=http://127.0.0.1:8000
HOST=127.0.0.1
PORT=5173
NASA_TIMEOUT_SECONDS=30
NASA_CACHE_HOURS=24
# NASA POWER es público y no requiere una API key.
# Para un despliegue protegido, APP_ENV=production y completar los tres:
API_INTERNAL_TOKEN=
WEB_USERNAME=
WEB_PASSWORD=
