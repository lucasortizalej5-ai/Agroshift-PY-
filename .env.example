# Copiar a .env en la raíz. No subir .env a Git.
APP_ENV=development
DATABASE_PATH=backend/data/agroshift.sqlite3
API_BASE_URL=http://127.0.0.1:8000
HOST=127.0.0.1
PORT=5173
NASA_TIMEOUT_SECONDS=30
NASA_CACHE_HOURS=24
# Puerto de acceso al usar Docker Compose: http://localhost:8080
# Compose fija internamente HOST, PORT, APP_ENV, API_BASE_URL y DATABASE_PATH.
AGROSHIFT_PORT=8080
# NASA POWER es público y no requiere una API key.
# Para Docker Compose o despliegue protegido, completar los tres:
# API_INTERNAL_TOKEN: clave aleatoria de al menos 32 caracteres.
# WEB_PASSWORD: contraseña de acceso de al menos 12 caracteres.
# Si un valor contiene $, # o espacios, encerrarlo entre comillas simples.
API_INTERNAL_TOKEN=
WEB_USERNAME=
WEB_PASSWORD=
